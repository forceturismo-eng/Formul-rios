# =============================================================================
# Plataforma SaaS de Formulários — variáveis de ambiente
# Copie para `.env` (nunca commite o `.env`) e ajuste o que for necessário.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Marca e domínios
# Estes três valores substituem os marcadores [PRODUTO] / [DOMINIO_APP] /
# [DOMINIO_CNAME]. Alterar aqui muda o nome exibido no app, nos e-mails e nas
# instruções de DNS mostradas ao cliente.
# -----------------------------------------------------------------------------
PRODUCT_NAME=Formulários
# Domínio da aplicação: login, painel e API autenticada vivem SOMENTE aqui.
APP_DOMAIN=app.formularios.local
# Domínio de destino do CNAME dos clientes (ver seção 8 do documento de produto).
CNAME_DOMAIN=custom.formularios.local

# URLs completas derivadas dos domínios acima (usadas em links de e-mail).
APP_URL=http://localhost:5173
API_URL=http://localhost:3333

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3333
# Origens aceitas pelo CORS do domínio da aplicação (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Banco de dados
#
# Dois papéis distintos, de propósito (ver docs/adr/0001-multi-tenant-rls.md):
#   app_runtime  -> usado pela aplicação. NOBYPASSRLS. É o que sofre o RLS.
#   app_migrator -> dono das tabelas. Roda migrations e seeds. Nunca serve requests.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://app_runtime:runtime_dev_pwd@localhost:5432/formularios?schema=public
MIGRATE_DATABASE_URL=postgresql://app_migrator:migrator_dev_pwd@localhost:5432/formularios?schema=public

# Superusuário usado apenas por `npm run db:roles` para criar papéis e o banco.
# Em produção isso é feito uma única vez, à mão, pelo DBA.
POSTGRES_SUPERUSER_URL=postgresql://postgres@localhost:5432/postgres

# Banco descartável do `prisma migrate dev` (detecção de drift).
# Criado pelo bootstrap de papéis. Não usado por `prisma migrate deploy`.
SHADOW_DATABASE_URL=postgresql://app_migrator:migrator_dev_pwd@localhost:5432/formularios_shadow?schema=public

# -----------------------------------------------------------------------------
# Redis (cache, filas BullMQ, rate limit)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Autenticação
#
# Gere segredos com: openssl rand -base64 48
# ACCESS e REFRESH usam segredos DIFERENTES de propósito: um access token não
# pode ser reapresentado como refresh token e vice-versa.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-este-valor-em-producao-access-0000000000000000
JWT_REFRESH_SECRET=troque-este-valor-em-producao-refresh-000000000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=formularios
JWT_AUDIENCE=formularios-app

# Cookie do refresh token (httpOnly). Em produção: COOKIE_SECURE=true.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Criptografia e hashing
#
# IP_HASH_SALT: sal fixo usado para hashear IP e user-agent. Trocar o sal
# invalida a correlação histórica — isso é intencional e aceitável.
# ENCRYPTION_MASTER_KEY: chave mestra AES-256-GCM (32 bytes em base64) usada no
# envelope encryption das respostas. Em produção, use KMS.
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
IP_HASH_SALT=troque-este-sal-em-producao-000000000000
ENCRYPTION_MASTER_KEY=q3ZJKXeMTbe+6a0mawsnBivPtbusaK0snfzPhC4uy7w=

# -----------------------------------------------------------------------------
# Storage S3-compatible (MinIO em dev). Bucket PRIVADO, sempre.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=formularios-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# E-mail (Resend em produção, Mailhog em dev)
# -----------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM="Formulários <nao-responda@formularios.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# IA (Claude API) — Fase 4. Chave NUNCA vai para o frontend.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5

# -----------------------------------------------------------------------------
# Pagamentos (Asaas) — Fase 3
# -----------------------------------------------------------------------------
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Fiscal (NFS-e) — Fase 3
NFSE_PROVIDER=
NFSE_API_KEY=
NFSE_ISS_RATE=0.02
NFSE_MUNICIPAL_CODE=

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
